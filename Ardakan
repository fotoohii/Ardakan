                name: "ذبیح‌الله صاحبی و فرهنگ‌نویسان اردکان",
                role: "پژوهشگر، شاعر و گردآورنده فرهنگ و گویش اردکان",
                bio: "از چهره‌های فرهنگی اثرگذار اردکان که سال‌ها در ثبت تاریخ، ادبیات و واژگان گویش اصیل اردکانی تلاش کردند."
            }
        ];

        const phoneDirectory = [
            { name: "بیمارستان سیدالشهدا (ع) اردکان", desc: "بیمارستان تخصصی و مرکز درمانی جدید شهر", phone: "03532262000" },
            { name: "بیمارستان ضیایی اردکان", desc: "بلوار آیت‌الله خامنه‌ای، مرکز درمانی و اورژانس", phone: "03532222115" },
            { name: "دانشگاه اردکان", desc: "تنها دانشگاه دولتی جامع شمال استان یزد", phone: "03532249100" },
            { name: "شهرداری اردکان (سامانه ۱۳۷)", desc: "خدمات شهری و ارتباط مردمی شهرداری", phone: "137" },
            { name: "فرمانداری شهرستان اردکان", desc: "خیابان امام خمینی (ره)", phone: "03532222001" },
            { name: "اداره میراث فرهنگی و گردشگری", desc: "راهنمای گردشگران و موزه‌های اردکان", phone: "03532224550" },
            { name: "ایستگاه راه‌آهن اردکان", desc: "اطلاعات حرکت قطارهای مسافربری", phone: "03532225666" },
            { name: "هتل جهانگردی اردکان", desc: "رزرو اتاق و خدمات اقامتی", phone: "03532222480" },
            { name: "اورژانس پزشکی", desc: "امداد اورژانس شبانه‌روزی سراسر شهرستان", phone: "115" },
            { name: "آتش‌نشانی و خدمات ایمنی", desc: "امداد و نجات شهری", phone: "125" },
            { name: "جمعیت هلال احمر اردکان", desc: "امداد جاده‌ای و کویر", phone: "112" },
            { name: "اطلاعات تلفن گویا", desc: "راهنمای شماره تلفن‌های شهرستان", phone: "118" }
        ];

        let currentCat = "همه";
        let searchQuery = "";
        let favorites = JSON.parse(localStorage.getItem("ardakan_favs_v2") || "[]");
        let activeItem = null;

        const itemsContainer = document.getElementById("itemsContainer");
        const favsContainer = document.getElementById("favsContainer");
        const phonesContainer = document.getElementById("phonesContainer");
        const videosContainer = document.getElementById("videosContainer");
        const photoGalleryGrid = document.getElementById("photoGalleryGrid");
        const dictContainer = document.getElementById("dictContainer");
        const celebsContainer = document.getElementById("celebsContainer");
        const searchInput = document.getElementById("searchInput");
        const clearSearch = document.getElementById("clearSearch");
        const detailModal = document.getElementById("detailModal");

        function renderItems() {
            const filtered = ardakanItems.filter(item => {
                const matchCat = currentCat === "همه" || item.cat === currentCat;
                const q = searchQuery.trim();
                const matchSearch = !q || item.title.includes(q) || item.short.includes(q) || item.full.includes(q) || item.loc.includes(q);
                return matchCat && matchSearch;
            });

            if (filtered.length === 0) {
                itemsContainer.innerHTML = `<div class="empty-state">موردی با این عبارت پیدا نشد! 🏜️</div>`;
                return;
            }

            itemsContainer.innerHTML = filtered.map(item => createCardHTML(item)).join("");
        }

        function createCardHTML(item) {
            const isFav = favorites.includes(item.id);
            return `
                <div class="item-card" onclick="openDetail(${item.id})">
                    <div class="card-img-wrap">
                        <div class="card-fallback-art">
                            <div>${item.icon}</div>
                            <span>${item.title}</span>
                        </div>
                        <img src="${item.img}" alt="${item.title}" onload="this.classList.add('loaded')" onerror="this.style.display='none'">
                        <span class="card-badge-overlay">${item.cat}</span>
                        ${isFav ? `<div class="card-fav-indicator">❤️</div>` : ''}
                    </div>
                    <div class="card-body">
                        <div class="card-title">${item.title}</div>
                        <p class="card-desc">${item.short}</p>
                        <div class="card-footer">
                            <span>📍 ${item.loc}</span>
                            <span style="color:var(--primary); font-weight:800;">جزئیات و عکس ←</span>
                        </div>
                    </div>
                </div>
            `;
        }

        function renderMedia() {
            videosContainer.innerHTML = ardakanVideos.map(v => `
                <div class="video-card">
                    <div class="video-thumb" onclick="window.open('https://www.aparat.com/search/${encodeURIComponent(v.aparatQuery)}', '_blank')">
                        <div class="card-fallback-art">🎬<span>${v.title}</span></div>
                        <img src="${v.img}" alt="${v.title}" onload="this.classList.add('loaded')" onerror="this.style.display='none'">
                        <div class="play-overlay">
                            <div class="play-circle">▶</div>
                            <span style="font-size:0.8rem; font-weight:700;">پخش مستند و ویدیو</span>
                        </div>
                        <span class="video-duration">⏱ ${v.duration}</span>
                    </div>
                    <div class="video-info">
                        <h4>${v.title}</h4>
                        <p>${v.desc}</p>
                        <div class="video-links">
                            <a href="https://www.aparat.com/search/${encodeURIComponent(v.aparatQuery)}" target="_blank" class="v-btn v-btn-aparat">📺 تماشا در آپارات</a>
                            <a href="https://www.youtube.com/results?search_query=${encodeURIComponent(v.ytQuery)}" target="_blank" class="v-btn v-btn-yt">▶️ تماشا در یوتیوب</a>
                        </div>
                    </div>
                </div>
            `).join("");

            photoGalleryGrid.innerHTML = ardakanItems.slice(0, 12).map(item => `
                <div class="gallery-item" onclick="openDetail(${item.id})">
                    <div class="card-fallback-art" style="font-size:2rem;">${item.icon}</div>
                    <img src="${item.img}" alt="${item.title}" onload="this.classList.add('loaded')" onerror="this.style.display='none'">
                    <div class="gallery-caption">${item.title}</div>
                </div>
            `).join("");
        }

        function renderCulture(filterText = "") {
            const q = filterText.trim();
            const filteredDict = ardakanDialect.filter(d => !q || d.word.includes(q) || d.meaning.includes(q));
            dictContainer.innerHTML = filteredDict.map(d => `
                <div class="dict-item">
                    <div>
                        <span class="dict-word">${d.word}</span>
                        <span class="dict-pron">(${d.pron})</span>
                    </div>
                    <div class="dict-meaning">${d.meaning}</div>
                </div>
            `).join("");

            celebsContainer.innerHTML = ardakanCelebs.map(c => `
                <div class="person-card">
                    <h4>${c.name}</h4>
                    <span class="person-role">${c.role}</span>
                    <p>${c.bio}</p>
                </div>
            `).join("");
        }

        document.getElementById("dictSearchInput").addEventListener("input", (e) => {
            renderCulture(e.target.value);
        });

        function renderFavs() {
            const favItems = ardakanItems.filter(i => favorites.includes(i.id));
            if (favItems.length === 0) {
                favsContainer.innerHTML = `<div class="empty-state">هنوز مکانی رو نشان نکردی!<br><small>توی صفحه جزئیات هر مکان می‌تونی روی دکمه افزودن به نشان‌ها بزنی.</small></div>`;
                return;
            }
            favsContainer.innerHTML = favItems.map(item => createCardHTML(item)).join("");
        }

        function renderPhones() {
            phonesContainer.innerHTML = phoneDirectory.map(p => `
                <div class="phone-card">
                    <div class="phone-info">
                        <h4>${p.name}</h4>
                        <p>${p.desc}</p>
                    </div>
                    <a href="tel:${p.phone}" class="call-btn">📞 ${p.phone}</a>
                </div>
            `).join("");
        }

        window.openDetail = function(id) {
            activeItem = ardakanItems.find(i => i.id === id);
            if (!activeItem) return;
            document.getElementById("modalHeroWrap").innerHTML = `
                <div class="card-fallback-art">${activeItem.icon}<span>${activeItem.title}</span></div>
                <img src="${activeItem.img}" alt="${activeItem.title}" onload="this.classList.add('loaded')" onerror="this.style.display='none'">
            `;
            document.getElementById("modalCat").textContent = activeItem.cat;
            document.getElementById("modalTitle").textContent = activeItem.title;
            document.getElementById("modalDesc").textContent = activeItem.full;
            document.getElementById("modalLoc").textContent = activeItem.loc;
            document.getElementById("modalTip").textContent = activeItem.tip;
            document.getElementById("modalMapBtn").href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(activeItem.mapQuery)}`;
            document.getElementById("modalVidBtn").href = `https://www.aparat.com/search/${encodeURIComponent(activeItem.title)}`;
            updateFavBtn();
            detailModal.classList.add("open");
        };

        function updateFavBtn() {
            const btn = document.getElementById("modalFavBtn");
            const isFav = favorites.includes(activeItem.id);
            btn.innerHTML = isFav ? "❤️ حذف از نشان‌ها" : "🤍 افزودن به نشان‌ها";
        }

        document.getElementById("modalFavBtn").addEventListener("click", () => {
            if (!activeItem) return;
            const idx = favorites.indexOf(activeItem.id);
            if (idx > -1) {
                favorites.splice(idx, 1);
            } else {
                favorites.push(activeItem.id);
            }
            localStorage.setItem("ardakan_favs_v2", JSON.stringify(favorites));
            updateFavBtn();
            renderItems();
            renderFavs();
        });

        document.getElementById("closeModalBtn").addEventListener("click", () => {
            detailModal.classList.remove("open");
        });

        detailModal.addEventListener("click", (e) => {
            if (e.target === detailModal) detailModal.classList.remove("open");
        });

        document.querySelectorAll("#categoryChips .chip").forEach(btn => {
            btn.addEventListener("click", () => {
                document.querySelectorAll("#categoryChips .chip").forEach(b => b.classList.remove("active"));
                btn.classList.add("active");
                currentCat = btn.getAttribute("data-cat");
                renderItems();
            });
        });

        searchInput.addEventListener("input", (e) => {
            searchQuery = e.target.value;
            clearSearch.style.display = searchQuery ? "block" : "none";
            if (searchQuery) switchTab("tab-explore");
            renderItems();
        });

        clearSearch.addEventListener("click", () => {
            searchInput.value = "";
            searchQuery = "";
            clearSearch.style.display = "none";
            renderItems();
        });

        function switchTab(targetId) {
            document.querySelectorAll(".tab-content").forEach(sec => sec.classList.remove("active"));
            document.getElementById(targetId).classList.add("active");
            document.querySelectorAll(".bottom-nav .nav-item").forEach(btn => {
                btn.classList.toggle("active", btn.getAttribute("data-target") === targetId);
            });
            window.scrollTo({ top: 0, behavior: "smooth" });
        }

        document.querySelectorAll(".bottom-nav .nav-item").forEach(btn => {
            btn.addEventListener("click", () => {
                switchTab(btn.getAttribute("data-target"));
            });
        });

        const themeToggle = document.getElementById("themeToggle");
        themeToggle.addEventListener("click", () => {
            const isDark = document.documentElement.getAttribute("data-theme") === "dark";
            if (isDark) {
                document.documentElement.removeAttribute("data-theme");
                themeToggle.textContent = "🌙";
            } else {
                document.documentElement.setAttribute("data-theme", "dark");
                themeToggle.textContent = "☀️";
            }
        });

        renderItems();
        renderMedia();
        renderCulture();
        renderPhones();
        renderFavs();
    </script>
</body>
</html>
